ommitted z and copy the leader's log. Nothing committed was lost; z was never acknowledged, so the client must retry it.","nodes":{"S1":{"sub":"t3  x y w"},"S2":{"sub":"t3  x y w"},"S3":{"sub":"t3  x y w"},"S4":{"sub":"t3  x y w"},"S5":{"cls":"a","sub":"t3  x y w"}},"edges":{"S1-S2":"hide","S1-S3":"hide","S1-S4":"hide","S1-S5":"a","S2-S3":"hide","S2-S4":"hide","S2-S5":"a","S3-S4":"hide","S3-S5":"a","S4-S5":"a"},"stats":[],"pos":{"S1":[190,25],"S2":[290,98],"S3":[252,215],"S4":[128,215],"S5":[90,98]}}]}]}