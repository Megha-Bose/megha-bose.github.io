{"title":"Signals flowing through gates","sub":"The inputs cycle through all four combinations. Green wires and gates are 1; gray are 0.","kind":"graph","interval":1600,"scenarioLabel":"Circuit","legend":[["good","1 (on)"],["muted","0 (off)"]],"scenarios":[{"name":"Half adder","graph":{"w":600,"h":260,"r":24,"nodes":[{"id":"A","x":70,"y":80,"label":"A","sub":"below"},{"id":"B","x":70,"y":190,"label":"B","sub":"below"},{"id":"x","x":300,"y":80,"label":"XOR","sub":"below"},{"id":"n","x":300,"y":190,"label":"AND","sub":"below"},{"id":"Sum","x":520,"y":80,"label":"Sum","sub":"below"},{"id":"Carry","x":520,"y":190,"label":"Carry","sub":"below"}],"edges":[{"u":"A","v":"x","dir":true},{"u":"B","v":"x","dir":true},{"u":"A","v":"n","dir":true},{"u":"B","v":"n","dir":true},{"u":"x","v":"Sum","dir":true},{"u":"n","v":"Carry","dir":true}]},"frames":[{"caption":"A half adder adds two bits: XOR gives the sum bit, AND gives the carry. Lit (green) wires carry a 1.","nodes":{},"edges":{},"stats":[]},{"caption":"A = 0, B = 0 → Sum = 0, Carry = 0. 0 + 0 = 0.","nodes":{"A":{"cls":"muted","sub":"0"},"B":{"cls":"muted","sub":"0"},"x":{"cls":"muted","sub":"0"},"n":{"cls":"muted","sub":"0"},"Sum":{"cls":"muted","sub":"0"},"Carry":{"cls":"muted","sub":"0"}},"edges":{"A-x":"muted","B-x":"muted","A-n":"muted","B-n":"muted","x-Sum":"muted","n-Carry":"muted"},"stats":[["A B","0 0"],["Sum",0],["Carry",0]]},{"caption":"A = 0, B = 1 → Sum = 1, Carry = 0. 0 + 1 = 1.","nodes":{"A":{"cls":"muted","sub":"0"},"B":{"cls":"good","sub":"1"},"x":{"cls":"good","sub":"1"},"n":{"cls":"muted","sub":"0"},"Sum":{"cls":"good","sub":"1"},"Carry":{"cls":"muted","sub":"0"}},"edges":{"A-x":"muted","B-x":"good","A-n":"muted","B-n":"good","x-Sum":"good","n-Carry":"muted"},"stats":[["A B","0 1"],["Sum",1],["Carry",0]]},{"caption":"A = 1, B = 0 → Sum = 1, Carry = 0. 1 + 0 = 1.","nodes":{"A":{"cls":"good","sub":"1"},"B":{"cls":"muted","sub":"0"},"x":{"cls":"good","sub":"1"},"n":{"cls":"muted","sub":"0"},"Sum":{"cls":"good