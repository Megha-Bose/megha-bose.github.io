","v":"Out","dir":true}]},"frames":[{"caption":"XOR from four NANDs: the classic construction. Watch the middle gate: it is 0 only when A and B are both 1.","nodes":{},"edges":{},"stats":[]},{"caption":"A = 0, B = 0 → Out = 0. Equal inputs (0, 0): output 0.","nodes":{"A":{"cls":"muted","sub":"0"},"B":{"cls":"muted","sub":"0"},"m":{"cls":"good","sub":"1"},"p":{"cls":"good","sub":"1"},"q":{"cls":"good","sub":"1"},"o":{"cls":"muted","sub":"0"},"Out":{"cls":"muted","sub":"0"}},"edges":{"A-m":"muted","B-m":"muted","A-p":"muted","m-p":"good","B-q":"muted","m-q":"good","p-o":"good","q-o":"good","o-Out":"muted"},"stats":[["A B","0 0"],["Out",0]]},{"caption":"A = 0, B = 1 → Out = 1. Different inputs: output 1.","nodes":{"A":{"cls":"muted","sub":"0"},"B":{"cls":"good","sub":"1"},"m":{"cls":"good","sub":"1"},"p":{"cls":"good","sub":"1"},"q":{"cls":"muted","sub":"0"},"o":{"cls":"good","sub":"1"},"Out":{"cls":"good","sub":"1"}},"edges":{"A-m":"muted","B-m":"good","A-p":"muted","m-p":"good","B-q":"good","m-q":"good","p-o":"good","q-o":"muted","o-Out":"good"},"stats":[["A B","0 1"],["Out",1]]},{"caption":"A = 1, B = 0 → Out = 1. Different inputs: output 1.","nodes":{"A":{"cls":"good","sub":"1"},"B":{"cls":"muted","sub":"0"},"m":{"cls":"good","sub":"1"},"p":{"cls":"muted","sub":"0"},"q":{"cls":"good","sub":"1"},"o":{"cls":"good","sub":"1"},"Out":{"cls":"good","sub":"1"}},"edges":{"A-m":"good","B-m":"muted","A-p":"good","m-p":"good","B-q":"muted","m-q":"good","p-o":"muted","q-o":"good","o-Out":"good"},"stats":[["A B","1 0"],["Out",1]]},{"caption":"A = 1, B = 1 → Out = 0. Equal inputs (1, 1): the middle NAND drops to 0, which forces both side NANDs to 1, and the last NAND outputs 0.","nodes":{"A":{"cls":"good","sub":"1"},"B":{"cls":"good","sub":"1"},"m":{"cls":"muted","sub":"0"},"p":{"cls":"good","sub":"1"},"q":{"cls":"good","sub":"1"},"o":{"cls":"muted","sub":"0"},"Out":{"cls":"muted","sub":"0"}},"edges":{"A-m":"good","B-m":"good","A-p":"good","m-p":"muted","B-q":"good","m-q":"muted