{"title":"Inserting into a linked list","sub":"Each node points to the next one. Nodes can live anywhere in memory, so inserting means rewiring, not shifting.","kind":"graph","interval":1100,"legend":[["b","where we are"],["a","the new node and its links"]],"graph":{"w":660,"h":210,"r":20,"nodes":[{"id":"n0","x":60,"y":150,"label":"12"},{"id":"n1","x":170,"y":150,"label":"5"},{"id":"n2","x":280,"y":150,"label":"8"},{"id":"n3","x":390,"y":150,"label":"3"},{"id":"n4","x":500,"y":150,"label":"9"},{"id":"nil","x":610,"y":150,"label":"∅"},{"id":"new","x":225,"y":55,"label":"99"},{"id":"head","x":60,"y":55,"label":"head"}],"edges":[{"u":"head","v":"n0","dir":true},{"u":"n0","v":"n1","dir":true},{"u":"n1","v":"n2","dir":true},{"u":"n2","v":"n3","dir":true},{"u":"n3","v":"n4","dir":true},{"u":"n4","v":"nil","dir":true},{"u":"n1","v":"new","dir":true},{"u":"new","v":"n2","dir":true}]},"frames":[{"caption":"Insert <b>99</b> after the node holding 5. There is no index arithmetic: the only way in is from <b>head</b>.","nodes":{"head":{"cls":"b"},"new":{"hide":true}},"edges":{"n1-new":"hide","new-n2":"hide"},"stats":[["Pointer steps",0]]},{"caption":"Follow head to the first node.","nodes":{"n0":{"cls":"b"},"head":{"cls":"muted"},"new":{"hide":true}},"edges":{"n1-new":"hide","new-n2":"hide"},"stats":[["Pointer steps",1]]},{"caption":"Follow its next pointer to 5. Finding the spot took O(n) pointer steps.","nodes":{"n0":{"cls":"muted"},"n1":{"cls":"b"},"head":{"cls":"muted"},"new":{"hide":true}},"edges":{"n1-new":"hide","new-n2":"hide","n0-n1":"b"},"stats":[["Pointer steps",2]]},{"caption":"Now the insertion itself. Make a new node holding 99.","nodes":{"n1":{"cls":"b"},"new":{"cls":"a"},"head":{"cls":"muted"}},"edges":{"n1-new":"hide","new-n2":"hide"},"stats":[["Pointer steps",2]]},{"caption":"Point the new node at 8, the node that comes after 5.","nodes":{"n1":{"cls":"b"},"new":{"cls":"a"},"head":{"cls":"muted"}},"edges":{"n1-new":"hide","new-n2":"a"},"stats":[["Pointer steps",2]]},{"caption":"Re-point 5 at the new node. The old link from 5 to 8 is gone.","nodes":{"n1":{"cls":"b"},"new":{"cls":"a"},"head":{"cls":"muted"}},"edges":{"n1-n2":"hide","n1-new":"a","new-n2":"a"},"stats":[["Pointer steps",2]]},{"caption":"Done. Two pointer changes, and <b>nothing moved</b>. With a pointer to 5 already in hand, insertion is O(1).","nodes":{"new":{"cls":"a"},"head":{"cls":"muted"}},"edges":{"n1-n2":"hide"},"stats":[["Pointer steps",2]]}]}