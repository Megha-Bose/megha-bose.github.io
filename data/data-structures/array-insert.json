{"title":"Inserting into an array","sub":"An array keeps its elements side by side with no gaps, so making room means shifting everything after the insertion point.","kind":"array","interval":650,"scenarioLabel":"Insert","legend":[["b","element being moved"],["a","new element"]],"scenarios":[{"name":"at index 1","frames":[{"caption":"Insert <b>99</b> at index 1. Index 1's slot is taken, so everything from there on must move right first.","values":[12,5,8,3,9,6,null],"cls":{},"marks":{"1":"▼"},"stats":[["Elements moved",0]]},{"caption":"Move 6 from index 5 to 6.","values":[12,5,8,3,9,null,6],"cls":{"6":"b"},"marks":{"1":"▼"},"stats":[["Elements moved",1]]},{"caption":"Move 9 from index 4 to 5.","values":[12,5,8,3,null,9,6],"cls":{"5":"b"},"marks":{"1":"▼"},"stats":[["Elements moved",2]]},{"caption":"Move 3 from index 3 to 4.","values":[12,5,8,null,3,9,6],"cls":{"4":"b"},"marks":{"1":"▼"},"stats":[["Elements moved",3]]},{"caption":"Move 8 from index 2 to 3.","values":[12,5,null,8,3,9,6],"cls":{"3":"b"},"marks":{"1":"▼"},"stats":[["Elements moved",4]]},{"caption":"Move 5 from index 1 to 2.","values":[12,null,5,8,3,9,6],"cls":{"2":"b"},"marks":{"1":"▼"},"stats":[["Elements moved",5]]},{"caption":"Write 99 into the gap. <b>5 moves</b> to make room: insertion near the front costs O(n).","values":[12,99,5,8,3,9,6],"cls":{"1":"a"},"marks":{},"stats":[["Elements moved",5]]}]},{"name":"at the front","frames":[{"caption":"Insert <b>99</b> at index 0. Index 0's slot is taken, so everything from there on must move right first.","values":[12,5,8,3,9,6,null],"cls":{},"marks":{"0":"▼"},"stats":[["Elements moved",0]]},{"caption":"Move 6 from index 5 to 6.","values":[12,5,8,3,9,null,6],"cls":{"6":"b"},"marks":{"0":"▼"},"stats":[["Elements moved",1]]},{"caption":"Move 9 from index 4 to 5.","values":[12,5,8,3,null,9,6],"cls":{"5":"b"},"marks":{"0":"▼"},"stats":[["Elements moved",2]]},{"caption":"Move 3 from index 3 to 4.","values":[12,5,8,null,3,9,6],"cls":{"4":"b"},"marks":{"0":"▼"},"stats":[["Elements moved",3]]},{"caption":"Move 8 from index 2 to 3.","values":[12,5,null,8,3,9,6],"cls":{"3":"b"},"marks":{"0":"▼"},"stats":[["Elements moved",4]]},{"caption":"Move 5 from index 1 to 2.","values":[12,null,5,8,3,9,6],"cls":{"2":"b"},"marks":{"0":"▼"},"stats":[["Elements moved",5]]},{"caption":"Move 12 from index 0 to 1.","values":[null,12,5,8,3,9,6],"cls":{"1":"b"},"marks":{"0":"▼"},"stats":[["Elements moved",6]]},{"caption":"Write 99 into the gap. <b>6 moves</b> to make room: insertion near the front costs O(n).","values":[99,12,5,8,3,9,6],"cls":{"0":"a"},"marks":{},"stats":[["Elements moved",6]]}]},{"name":"at the end","frames":[{"caption":"Insert <b>99</b> at the end. The next slot is already free.","values":[12,5,8,3,9,6,null],"cls":{},"marks":{"6":"▼"},"stats":[["Elements moved",0]]},{"caption":"Write 99 straight in. <b>No moves</b>: appending to an array is O(1).","values":[12,5,8,3,9,6,99],"cls":{"6":"a"},"marks":{},"stats":[["Elements moved",0]]}]}]}