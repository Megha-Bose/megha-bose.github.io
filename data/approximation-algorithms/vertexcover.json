{"title":"A 2-approximation for vertex cover","sub":"Take both ends of any uncovered edge. The proof is in the orange edges.","kind":"graph","interval":1400,"legend":[["a","chosen"],["b","matched edge (both ends taken)"],["muted","already covered"]],"graph":{"w":600,"h":270,"r":20,"nodes":[{"id":"a","x":80,"y":60},{"id":"b","x":230,"y":50},{"id":"c","x":380,"y":60},{"id":"d","x":530,"y":70},{"id":"e","x":90,"y":200},{"id":"f","x":240,"y":220},{"id":"g","x":390,"y":200},{"id":"h","x":530,"y":220}],"edges":[{"u":"a","v":"b"},{"u":"b","v":"c"},{"u":"b","v":"f"},{"u":"c","v":"d"},{"u":"c","v":"g"},{"u":"e","v":"f"},{"u":"f","v":"g"},{"u":"g","v":"h"},{"u":"a","v":"e"},{"u":"d","v":"h"},{"u":"b","v":"g"}]},"frames":[{"caption":"Cover every edge using as few vertices as possible. The rule: find any edge with <b>neither</b> end chosen, and take <b>both</b> ends.","nodes":{},"edges":{},"stats":[["Matched edges",0],["Cover size",0]]},{"caption":"Edge a–b has neither end chosen: take both a and b.","nodes":{"b":{"cls":"a"},"a":{"cls":"a"}},"edges":{"a-b":"b","b-c":"muted","b-f":"muted","a-e":"muted","b-g":"muted"},"stats":[["Matched edges",1],["Cover size",2]]},{"caption":"Edge b–c is already covered (gray). Skip it.","nodes":{"b":{"cls":"a"},"a":{"cls":"a"}},"edges":{"a-b":"b","b-c":"muted","b-f":"muted","a-e":"muted","b-g":"muted"},"stats":[["Matched edges",1],["Cover size",2]]},{"caption":"Edge b–f is already covered (gray). Skip it.","nodes":{"b":{"cls":"a"},"a":{"cls":"a"}},"edges":{"a-b":"b","b-c":"muted","b-f":"muted","a-e":"muted","b-g":"muted"},"stats":[["Matched edges",1],["Cover size",2]]},{"caption":"Edge c–d has neither end chosen: take both c and d.","nodes":{"c":{"cls":"a"},"b":{"cls":"a"},"d":{"cls":"a"},"a":{"cls":"a"}},"edges":{"a-b":"b","b-c":"muted","b-f":"muted","c-d":"b","c-g":"muted","a-e":"muted","d-h":"muted","b-g":"muted"},"stats":[["Matched edges",2],["Cover size",4]]},{"caption":"Edge c–g is already covered (gray). Skip it.","nodes":{"c":{"cls":"a"