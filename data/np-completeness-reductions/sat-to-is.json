e},"c21":{"hide":true},"c22":{"hide":true}},"edges":{"c10-c11":"hide","c11-c12":"hide","c10-c12":"hide","c20-c21":"hide","c21-c22":"hide","c20-c22":"hide","c00-c10":"hide","c01-c21":"hide","c02-c12":"hide","c02-c22":"hide","c10-c20":"hide","c11-c21":"hide"},"stats":[]},{"caption":"Clause 2, (¬x ∨ y ∨ z), becomes a <b>triangle</b>: one vertex per literal, all joined. An independent set can take at most one vertex from it.","nodes":{"c00":{},"c01":{},"c02":{},"c10":{"cls":"c"},"c11":{"cls":"c"},"c12":{"cls":"c"},"c20":{"hide":true},"c21":{"hide":true},"c22":{"hide":true}},"edges":{"c20-c21":"hide","c21-c22":"hide","c20-c22":"hide","c00-c10":"hide","c01-c21":"hide","c02-c12":"hide","c02-c22":"hide","c10-c20":"hide","c11-c21":"hide"},"stats":[]},{"caption":"Clause 3, (x ∨ ¬y ∨ z), becomes a <b>triangle</b>: one vertex per literal, all joined. An independent set can take at most one vertex from it.","nodes":{"c00":{},"c01":{},"c02":{},"c10":{},"c11":{},"c12":{},"c20":{"cls":"c"},"c21":{"cls":"c"},"c22":{"cls":"c"}},"edges":{"c00-c10":"hide","c01-c21":"hide","c02-c12":"hide","c02-c22":"hide","c10-c20":"hide","c11-c21":"hide"},"stats":[]},{"caption":"<b>Conflict edges</b> join every x to every ¬x, so an independent set can never pick both a literal and its opposite.","nodes":{"c00":{},"c01":{},"c02":{},"c10":{},"c11":{},"c12":{},"c20":{},"c21":{},"c22":{}},"edges":{"c01-c21":"hide","c02-c12":"hide","c02-c22":"hide","c11-c21":"hide","c00-c10":"b","c10-c20":"b"},"stats":[]},{"caption":"<b>Conflict edges</b> join every y to every ¬y, so an independent set can never pick both a literal and its opposite.","nodes":{"c00":{},"c01":{},"c02":{},"c10":{},"c11":{},"c12":{},"c20":{},"c21":{},"c22":{}},"edges":{"c02-c12":"hide","c02-c22":"hide","c01-c21":"b","c11-c21":"b"},"stats":[]},{"caption":"<b>Conflict edges</b> join every z to every ¬z, so an independent set can never pick both a literal and its opposite.","nodes":{"c00":{},"c01":{},"c02":{},"c10":{},"c11":{},"c12":{},"c20":{},"