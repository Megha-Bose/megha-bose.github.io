,"bit","adds"]},"frames":[{"caption":"Read 10110100. Each bit either contributes its weight or contributes nothing.","cells":[[128,64,32,16,8,4,2,1],[1,0,1,1,0,1,0,0],["","","","","","","",""]],"cellCls":{"1,0":"a","1,1":"muted","1,2":"a","1,3":"a","1,4":"muted","1,5":"a","1,6":"muted","1,7":"muted"},"stats":[["Running total",0]]},{"caption":"Bit 1 is 1: add 128.","cells":[[128,64,32,16,8,4,2,1],[1,0,1,1,0,1,0,0],[128,"","","","","","",""]],"cellCls":{"1,0":"a","1,1":"muted","1,2":"a","1,3":"a","1,4":"muted","1,5":"a","1,6":"muted","1,7":"muted","0,0":"b","2,0":"b"},"stats":[["Running total",128]]},{"caption":"Bit 2 is 0: skip 64.","cells":[[128,64,32,16,8,4,2,1],[1,0,1,1,0,1,0,0],[128,0,"","","","","",""]],"cellCls":{"1,0":"a","1,1":"muted","1,2":"a","1,3":"a","1,4":"muted","1,5":"a","1,6":"muted","1,7":"muted","0,1":"muted","2,1":"muted"},"stats":[["Running total",128]]},{"caption":"Bit 3 is 1: add 32.","cells":[[128,64,32,16,8,4,2,1],[1,0,1,1,0,1,0,0],[128,0,32,"","","","",""]],"cellCls":{"1,0":"a","1,1":"muted","1,2":"a","1,3":"a","1,4":"muted","1,5":"a","1,6":"muted","1,7":"muted","0,2":"b","2,2":"b"},"stats":[["Running total",160]]},{"caption":"Bit 4 is 1: add 16.","cells":[[128,64,32,16,8,4,2,1],[1,0,1,1,0,1,0,0],[128,0,32,16,"","","",""]],"cellCls":{"1,0":"a","1,1":"muted","1,2":"a","1,3":"a","1,4":"muted","1,5":"a","1,6":"muted","1,7":"muted","0,3":"b","2,3":"b"},"stats":[["Running total",176]]},{"caption":"Bit 5 is 0: skip 8.","cells":[[128,64,32,16,8,4,2,1],[1,0,1,1,0,1,0,0],[128,0,32,16,0,"","",""]],"cellCls":{"1,0":"a","1,1":"muted","1,2":"a","1,3":"a","1,4":"muted","1,5":"a","1,6":"muted","1,7":"muted","0,4":"muted","2,4":"muted"},"stats":[["Running total",176]]},{"caption":"Bit 6 is 1: add 4.","cells":[[128,64,32,16,8,4,2,1],[1,0,1,1,0,1,0,0],[128,0,32,16,0,4,"",""]],"cellCls":{"1,0":"a","1,1":"muted","1,2":"a","1,3":"a","1,4":"muted","1,5":"a","1,6":"muted","1,7":"muted","0,5":"b","2,5":"b"},"stats":[["Running total",180]]},{"caption":"Bit 7 is 0: skip 2.","cells":[[128,64,32,16,8,4,2,1],[1,0,1,1,0,1,0,0],[128,0,32,16,0,4,0,""]],"cellCls":{"1,0":"a","1,1":"muted","1,2":"a","1,3":"a","1,4":"muted","1,5":"a","1,6":"muted","1,7":"muted","0,6":"muted","2,6":"muted"},"stats":[["Running total",180]]},{"caption":"Bit 8 is 0: skip 1.","cells":[[128,64,32,16,8,4,2,1],[1,0,1,1,0,1,0,0],[128,0,32,16,0,4,0,0]],"cellCls":{"1,0":"a","1,1":"muted","1,2":"a","1,3":"a","1,4":"muted","1,5":"a","1,6":"muted","1,7":"muted","0,7":"muted","2,7":"muted"},"stats":[["Running total",180]]},{"caption":"128 + 32 + 16 + 4 = <b>180</b>. Every whole number from 0 to 255 has exactly one 8-bit pattern.","cells":[[128,64,32,16,8,4,2,1],[1,0,1,1,0,1,0,0],[128,0,32,16,0,4,0,0]],"cellCls":{"2,0":"good","2,2":"good","2,3":"good","2,5":"good"},"stats":[["Running total",180]]}]},{"name":"Divide by 2","grid":{"colLabels":["step","quotient","remainder"]},"frames":[{"caption":"Decimal to binary: divide by 2 and keep the remainder. Each remainder is the next bit, starting from the right.","cells":[["","",""],["","",""],["","",""],["","",""],["","",""],["","",""]],"cellCls":{},"stats":[["Binary so far","-"]]},{"caption":"42 ÷ 2 = 21 remainder <b>0</b>: that's the lowest bit.","cells":[["42 ÷ 2","21","0"],["","",""],["","",""],["","",""],["","",""],["","",""]],"cellCls":{"0,2":"b"},"stats":[["Binary so far","0"]]},{"caption":"21 ÷ 2 = 10 remainder <b>1</b>.","cells":[["42 ÷ 2","21","0"],["21 ÷ 2","10","1"],["","",""],["","",""],["","",""],["","",""]],"cellCls":{"1,2":"b"},"stats":[["Binary so far","10"]]},{"caption":"10 ÷ 2 = 5 remainder <b>0</b>.","cells":[["42 ÷ 2","21","0"],["21 ÷ 2","10","1"],["10 ÷ 2","5","0"],["","",""],["","",""],["","",""]],"cellCls":{"2,2":"b"},"stats":[["Binary so far","010"]]},{"caption":"5 ÷ 2 = 2 remainder <b>1</b>.","cells":[["42 ÷ 2","21","0"],["21 ÷ 2","10","1"],["10 ÷ 2","5","0"],["5 ÷ 2","2","1"],["","",""],["","",""]],"cellCls":{"3,2":"b"},"stats":[["Binary so far","1010"]]},{"caption":"2 ÷ 2 = 1 remainder <b>0</b>.","cells":[["42 ÷ 2","21","0"],["21 ÷ 2","10","1"],["10 ÷ 2","5","0"],["5 ÷ 2","2","1"],["2 ÷ 2","1","0"],["","",""]],"cellCls":{"4,2":"b"},"stats":[["Binary so far","01010"]]},{"caption":"1 ÷ 2 = 0 remainder <b>1</b>. The quotient is 0, so stop.","cells":[["42 ÷ 2","21","0"],["21 ÷ 2","10","1"],["10 ÷ 2","5","0"],["5 ÷ 2","2","1"],["2 ÷ 2","1","0"],["1 ÷ 2","0","1"]],"cellCls":{"5,2":"b"},"stats":[["Binary so far","101010"]]},{"caption":"Read the remainders from the bottom up: <b>101010</b>. Check: 32 + 8 + 2 = 42. Each division peeled off one bit from the right.","cells":[["42 ÷ 2","21","0"],["21 ÷ 2","10","1"],["10 ÷ 2","5","0"],["5 ÷ 2","2","1"],["2 ÷ 2","1","0"],["1 ÷ 2","0","1"]],"cellCls":{"0,2":"good","1,2":"good","2,2":"good","3,2":"good","4,2":"good","5,2":"good"},"stats":[["Binary","101010"]]}],"interval":1400},{"name":"To hex","grid":{"rowLabels":["weight","bit","hex"]},"frames":[{"caption":"Hexadecimal: split the byte into two groups of 4 bits (nibbles). Each nibble is worth 0 to 15, which is exactly one hex digit, 0-9 then A-F.","cells":[[8,4,2,1,8,4,2,1],[1,0,1,1,0,1,0,0],["","","","","","","",""]],"cellCls":{"1,0":"a","1,1":"a","1,2":"a","1,3":"a","1,4":"c","1,5":"c","1,6":"c","1,7":"c"},"stats":[["Hex","0x??"]]},{"caption":"Left nibble 1011 = 8 + 2 + 1 = 11, which is <b>B</b>.","cells":[[8,4,2,1,8,4,2,1],[1,0,1,1,0,1,0,0],["","","","B","","","",""]],"cellCls":{"1,0":"a","1,1":"a","1,2":"a","1,3":"a","2,3":"a"},"stats":[["Hex","0xB?"]]},{"caption":"Right nibble 0100 = <b>4</b>. So 10110100 = <b>0xB4</b>: two hex digits per byte, which is why memory dumps and colour codes (#FF5733) use hex.","cells":[[8,4,2,1,8,4,2,1],[1,0,1,1,0,1,0,0],["","","","B","","","","4"]],"cellCls":{"1,4":"c","1,5":"c","1,6":"c","1,7":"c","2,3":"good","2,7":"good"},"stats":[["Hex","0xB4"]]}],"interval":2400}]}