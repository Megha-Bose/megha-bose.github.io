{"title":"Is it a function? Injective? Surjective?","sub":"Inputs on the left, outputs on the right. Each test looks for one specific thing.","kind":"graph","interval":2300,"scenarioLabel":"Mapping","legend":[["good","passes the test"],["bad","breaks it"]],"scenarios":[{"name":"Not a function","graph":{"w":580,"h":192,"r":18,"nodes":[{"id":"a0","x":120,"y":40,"label":"Ana"},{"id":"a1","x":120,"y":96,"label":"Ben"},{"id":"a2","x":120,"y":152,"label":"Cy"},{"id":"b0","x":460,"y":40,"label":"555-1"},{"id":"b1","x":460,"y":96,"label":"555-2"},{"id":"b2","x":460,"y":152,"label":"555-3"}],"edges":[{"u":"a0","v":"b0","dir":true},{"u":"a0","v":"b1","dir":true},{"u":"a2","v":"b2","dir":true}]},"frames":[{"caption":"People → phone numbers. Ana has two numbers; Ben has none.","nodes":{},"edges":{"a0-b0":"muted","a0-b1":"muted","a2-b2":"muted"},"stats":[["Function?","?"],["Injective?","?"],["Surjective?","?"]]},{"caption":"<b>Function?</b> No: Ana has 2 arrows and Ben has no arrow. Every input needs exactly one output, so nothing else matters.","nodes":{"a0":{"cls":"bad"},"a1":{"cls":"bad"},"a2":{"cls":"good"}},"edges":{"a0-b0":"bad","a0-b1":"bad","a2-b2":"muted"},"stats":[["Function?","no"],["Injective?","-"],["Surjective?","-"]]}]},{"name":"x² on {−2, −1, 1, 2}","graph":{"w":580,"h":248,"r":18,"nodes":[{"id":"a0","x":120,"y":40,"label":"−2"},{"id":"a1","x":120,"y":96,"label":"−1"},{"id":"a2","x":120,"y":152,"label":"1"},{"id":"a3","x":120,"y":208,"label":"2"},{"id":"b0","x":460,"y":40,"label":"1"},{"id":"b1","x":460,"y":96,"label":"4"},{"id":"b2","x":460,"y":152,"label":"9"}],"edges":[{"u":"a0","v":"b1","dir":true},{"u":"a1","v":"b0","dir":true},{"u":"a2","v":"b0","dir":true},{"u":"a3","v":"b1","dir":true}]},"frames":[{"caption":"f(x) = x² from {−2, −1, 1, 2} to {1, 4, 9}. Squaring forgets the sign.","nodes":{},"edges":{"a0-b1":"muted","a1-b0":"muted","a2-b0":"muted","a3-b1":"muted"},"stats":[["Function?","?"],["Injective?","?"],["Surjective?","?"]]},{"caption":"<b>Function?<