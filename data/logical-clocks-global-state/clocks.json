avels with the message.","nodes":{"a1":{"sub":"1"},"b1":{"sub":"1"},"c1":{"sub":"1"},"a2":{"sub":"2"},"c2":{"sub":"2"},"b2":{"sub":"3"},"b3":{"sub":"4","cls":"b"},"c3":{"hide":true},"c4":{"hide":true},"a3":{"hide":true}},"edges":{"a1-a2":"muted","c1-c2":"muted","b1-b2":"muted","b2-b3":"muted","c2-c3":"hide","c3-c4":"hide","a2-a3":"hide","a2-b2":"a","b3-c3":"hide","c4-a3":"hide"},"stats":[["Event","b3"],["Timestamp","4"]]},{"caption":"c3: receives m2 on P3. On receive, jump to max(own counter, message's timestamp) + 1, so the receive is later than the send.","nodes":{"a1":{"sub":"1"},"b1":{"sub":"1"},"c1":{"sub":"1"},"a2":{"sub":"2"},"c2":{"sub":"2"},"b2":{"sub":"3"},"b3":{"sub":"4"},"c3":{"sub":"5","cls":"b"},"c4":{"hide":true},"a3":{"hide":true}},"edges":{"a1-a2":"muted","c1-c2":"muted","b1-b2":"muted","b2-b3":"muted","c2-c3":"muted","c3-c4":"hide","a2-a3":"hide","a2-b2":"a","b3-c3":"a","c4-a3":"hide"},"stats":[["Event","c3"],["Timestamp","5"]]},{"caption":"c4: sends m3 on P3. Tick, and the timestamp travels with the message.","nodes":{"a1":{"sub":"1"},"b1":{"sub":"1"},"c1":{"sub":"1"},"a2":{"sub":"2"},"c2":{"sub":"2"},"b2":{"sub":"3"},"b3":{"sub":"4"},"c3":{"sub":"5"},"c4":{"sub":"6","cls":"b"},"a3":{"hide":true}},"edges":{"a1-a2":"muted","c1-c2":"muted","b1-b2":"muted","b2-b3":"muted","c2-c3":"muted","c3-c4":"muted","a2-a3":"hide","a2-b2":"a","b3-c3":"a","c4-a3":"hide"},"stats":[["Event","c4"],["Timestamp","6"]]},{"caption":"a3: receives m3 on P1. On receive, jump to max(own counter, message's timestamp) + 1, so the receive is later than the send.","nodes":{"a1":{"sub":"1"},"b1":{"sub":"1"},"c1":{"sub":"1"},"a2":{"sub":"2"},"c2":{"sub":"2"},"b2":{"sub":"3"},"b3":{"sub":"4"},"c3":{"sub":"5"},"c4":{"sub":"6"},"a3":{"sub":"7","cls":"b"}},"edges":{"a1-a2":"muted","c1-c2":"muted","b1-b2":"muted","b2-b3":"muted","c2-c3":"muted","c3-c4":"muted","a2-a3":"muted","a2-b2":"a","b3-c3":"a","c4-a3":"a"},"stats":[["Event","a3"],["Timestamp","7"]]},{"caption":"Every causal chain